# SQLite database (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Session signing secret. Generate a long random string for local use.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seeded local accounts (no email). Change after first login.
AUTH_USERNAME_ADMIN="admin"
AUTH_PASSWORD_ADMIN="admin123"
AUTH_USERNAME_LEARNER="learner"
AUTH_PASSWORD_LEARNER="learner123"

# AvalAI (OpenAI-compatible). Leave API key empty to run fully offline.
AVALAI_API_KEY=
AVALAI_BASE_URL="https://api.avalai.ir/v1"
AVALAI_MODEL="gpt-4o-mini"
AVALAI_TIMEOUT_MS=30000
AVALAI_MAX_RETRIES=2
AVALAI_MAX_TOKENS=2048
AVALAI_CHAT_PATH="/chat/completions"

# Docker lab sandbox
LAB_CPU_LIMIT="0.5"
LAB_MEMORY_LIMIT="512m"
LAB_TIMEOUT_SECONDS=1800
LAB_MAX_PROCESSES=64
LAB_IMAGE="devops-learn-lab:latest"

# Terminal PTY gateway (separate Node process)
TERMINAL_GATEWAY_PORT=3001
NEXT_PUBLIC_TERMINAL_GATEWAY_URL="ws://127.0.0.1:3001"

APP_URL="http://localhost:3000"
